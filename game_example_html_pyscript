    <title>PyScript Example</title>
    <link rel="stylesheet" href="https://pyscript.net/latest/pyscript.css">
    <script defer src="https://pyscript.net/latest/pyscript.js"></script>

    <h1>Simple Question and Answer Game</h1>
    <p>What is 2 + 2?</p>

    <!-- Input box for user's answer -->
    <input type="text" id="answer" placeholder="Type your answer here">

    <!-- Button to submit the answer -->
    <button id="submit-button" py-click="check_answer()">Submit</button>

    <!-- Area to display the result -->
    <p id="result"></p>

    <!-- PyScript section for the game logic -->
    <py-script>
        # Function to check the user's answer
        def check_answer():
            # Get the user's input from the input box
            user_answer = Element("answer").element.value
            
            # Check if the answer is correct
            if user_answer == "4":
                result = "Correct! 2 + 2 is 4."
            else:
                result = "Incorrect. Try again!"
            
            # Display the result
            Element("result").element.innerText = result

            say_hello = lambda: "Hello World!"
            print(say_hello())

    </py-script>



